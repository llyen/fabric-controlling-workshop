		lineageTag: 63d9a71d-9963-58c8-b177-aa63a72ecf9b

	/// Odchylenie prognozy od budżetu dla pozycji Sprzedaż netto jako procent budżetu.
	measure 'Odchylenie sprzedaży FC vs BUD %' = DIVIDE ( [Odchylenie sprzedaży FC vs BUD], [Sprzedaż netto BUD] )
		formatString: 0.0%
		displayFolder: 4. Odchylenia
		lineageTag: b39b06f1-663d-5d2c-ade1-2245f57abf52

	/// Prognoza 8+4 minus budżet w PLN dla pozycji EBITDA. Ma sens dla roku finansowego 2026/27.
	measure 'Odchylenie EBITDA FC vs BUD' = [EBITDA FC] - [EBITDA BUD]
		formatString: #,0
		displayFolder: 4. Odchylenia
		lineageTag: 4217a5d9-f48b-5ddd-9851-d14e3bf3e2dc

	/// Odchylenie prognozy od budżetu dla pozycji EBITDA jako procent budżetu.
	measure 'Odchylenie EBITDA FC vs BUD %' = DIVIDE ( [Odchylenie EBITDA FC vs BUD], ABS ( [EBITDA BUD] ) )
		formatString: 0.0%
		displayFolder: 4. Odchylenia
		lineageTag: ccbfe5ea-d37a-555e-806b-f2cee69c8102

