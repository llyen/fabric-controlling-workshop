		lineageTag: 4e12bf89-e473-5343-bfe4-56b22e76e6f7

	/// EBITDA w PLN: marża brutto minus koszty operacyjne, budżet (BUD) dla lat finansowych 2024/25, 2025/26 i 2026/27.
	measure 'EBITDA BUD' = [Marża brutto BUD] - [Koszty operacyjne BUD]
