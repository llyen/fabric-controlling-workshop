	/// Marża brutto według wykonania za analogiczne miesiące zamknięte rok wcześniej (przesunięcie o 12 miesięcy).
	measure 'Marża brutto ACT rok wcześniej' = CALCULATE ( [Marża brutto ACT], DATEADD ( CALCULATETABLE ( VALUES ( 'Data'[Data] ), KEEPFILTERS ( 'Data'[Miesiąc zamknięty] = TRUE () ) ), -1, YEAR ) )
		formatString: #,0
