	/// Kwota według wykonania za analogiczne miesiące zamknięte rok wcześniej (przesunięcie o 12 miesięcy).
	measure 'Kwota ACT rok wcześniej' = CALCULATE ( [Kwota ACT], DATEADD ( CALCULATETABLE ( VALUES ( 'Data'[Data] ), KEEPFILTERS ( 'Data'[Miesiąc zamknięty] = TRUE () ) ), -1, YEAR ) )
