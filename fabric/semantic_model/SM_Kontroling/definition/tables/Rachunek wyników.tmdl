	/// Sprzedaż netto według wykonania za analogiczne miesiące zamknięte rok wcześniej (przesunięcie o 12 miesięcy).
	measure 'Sprzedaż netto ACT rok wcześniej' = CALCULATE ( [Sprzedaż netto ACT], DATEADD ( CALCULATETABLE ( VALUES ( 'Data'[Data] ), KEEPFILTERS ( 'Data'[Miesiąc zamknięty] = TRUE () ) ), -1, YEAR ) )
		formatString: #,0
		displayFolder: 5. Rok do roku
		lineageTag: ef00e805-4c8c-535a-b8c8-ce75d8386836

	/// Zmiana rok do roku pozycji Sprzedaż netto według wykonania, w procentach, za miesiące zamknięte.
	measure 'Dynamika sprzedaży ACT r/r %' =
			VAR _ly = [Sprzedaż netto ACT rok wcześniej]
			RETURN
			    DIVIDE ( [Sprzedaż netto ACT] - _ly, ABS ( _ly ) )
		formatString: 0.0%
		displayFolder: 5. Rok do roku
		lineageTag: 2285c54a-cba4-5d79-aa9e-f54d47730a5d

	/// EBITDA według wykonania za analogiczne miesiące zamknięte rok wcześniej (przesunięcie o 12 miesięcy).
	measure 'EBITDA ACT rok wcześniej' = CALCULATE ( [EBITDA ACT], DATEADD ( CALCULATETABLE ( VALUES ( 'Data'[Data] ), KEEPFILTERS ( 'Data'[Miesiąc zamknięty] = TRUE () ) ), -1, YEAR ) )
		formatString: #,0
		displayFolder: 5. Rok do roku
		lineageTag: 6fc38189-1c54-578a-a1f5-48589b928dbd

	/// Zmiana rok do roku pozycji EBITDA według wykonania, w procentach, za miesiące zamknięte.
	measure 'Dynamika EBITDA ACT r/r %' =
			VAR _ly = [EBITDA ACT rok wcześniej]
			RETURN
			    DIVIDE ( [EBITDA ACT] - _ly, ABS ( _ly ) )
		formatString: 0.0%
		displayFolder: 5. Rok do roku
