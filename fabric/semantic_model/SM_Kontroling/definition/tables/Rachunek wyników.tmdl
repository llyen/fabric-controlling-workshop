	/// Marża EBITDA jako procent sprzedaży netto, budżet (BUD) dla lat finansowych 2024/25, 2025/26 i 2026/27.
	measure 'EBITDA % BUD' = DIVIDE ( [EBITDA BUD], [Sprzedaż netto BUD] )
