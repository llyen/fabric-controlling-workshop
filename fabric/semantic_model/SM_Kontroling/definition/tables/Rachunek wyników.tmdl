/// Miesięczny rachunek wyników (P&L) na poziomie MPK, konta i scenariusza, w PLN. Wykonanie (ACT) obejmuje tylko miesiące zamknięte, od kwietnia 2023 do listopada 2026. Budżet (BUD) obejmuje lata finansowe 2024/25, 2025/26 i 2026/27. Prognoza (FC 8+4) obejmuje rok 2026/27. Używaj miar, nie sumuj kwot bez filtra scenariusza i konta.
table 'Rachunek wyników'
	lineageTag: f801fe69-93c9-57c7-99f6-a437e8d3c0d3

	/// Suma kwot rachunku wyników dla dokładnie jednego scenariusza wybranego filtrem. Bez filtra scenariusza zwraca pustą wartość, żeby nie dodawać wykonania do budżetu. Kwoty są dodatnie, także koszty.
	measure 'Kwota (jeden scenariusz)' = IF ( HASONEVALUE ( 'Scenariusz'[Kod scenariusza] ), SUM ( 'Rachunek wyników'[kwota_pln] ) )
		formatString: #,0
		displayFolder: 0. Pomocnicze
		lineageTag: 5a8c32fa-123e-551e-8e6a-710fbcfe3b73

	/// Kwota w PLN dla scenariusza wykonanie (ACT), tylko miesiące zamknięte do listopada 2026. Działa dla dowolnego konta lub grupy kont wybranych filtrem tabeli Konto, np. czynsze to konto 5120. Koszty są dodatnie.
	measure 'Kwota ACT' = CALCULATE ( SUM ( 'Rachunek wyników'[kwota_pln] ), REMOVEFILTERS ( 'Scenariusz' ), 'Scenariusz'[Kod scenariusza] = "ACT" )
		formatString: #,0
		displayFolder: 1. Wykonanie (ACT)
		lineageTag: 79460134-4456-55d5-a6e7-8ec68fa8cb56

	/// Przychody ze sprzedaży netto (konto 4010) w PLN, wykonanie (ACT), tylko miesiące zamknięte do listopada 2026.
	measure 'Sprzedaż netto ACT' = CALCULATE ( [Kwota ACT], REMOVEFILTERS ( 'Konto' ), 'Konto'[Numer konta] = "4010" )
		formatString: #,0
		displayFolder: 1. Wykonanie (ACT)
		lineageTag: 333c17c1-a77f-5c9e-8eb2-e55a64961d90

	/// Koszt własny sprzedaży (konto 4510) w PLN, wykonanie (ACT), tylko miesiące zamknięte do listopada 2026.
	measure 'Koszt własny ACT' = CALCULATE ( [Kwota ACT], REMOVEFILTERS ( 'Konto' ), 'Konto'[Numer konta] = "4510" )
		formatString: #,0
		displayFolder: 1. Wykonanie (ACT)
		lineageTag: 746b7056-1f9e-53ae-96cb-ed22f474b67a

	/// Marża brutto w PLN (sprzedaż netto minus koszt własny), wykonanie (ACT), tylko miesiące zamknięte do listopada 2026.
	measure 'Marża brutto ACT' = [Sprzedaż netto ACT] - [Koszt własny ACT]
		formatString: #,0
		displayFolder: 1. Wykonanie (ACT)
		lineageTag: cd8011f5-8279-5f11-ad53-1f9f08b1123c

	/// Marża brutto jako procent sprzedaży netto, wykonanie (ACT), tylko miesiące zamknięte do listopada 2026.
	measure 'Marża brutto % ACT' = DIVIDE ( [Marża brutto ACT], [Sprzedaż netto ACT] )
		formatString: 0.0%
		displayFolder: 1. Wykonanie (ACT)
		lineageTag: fac8d359-5961-5064-bd2c-a88c0e6bb59b

	/// Suma kosztów operacyjnych w PLN, wykonanie (ACT), tylko miesiące zamknięte do listopada 2026.
	measure 'Koszty operacyjne ACT' = CALCULATE ( [Kwota ACT], REMOVEFILTERS ( 'Konto' ), 'Konto'[Sekcja P&L] = "Koszty operacyjne" )
		formatString: #,0
		displayFolder: 1. Wykonanie (ACT)
		lineageTag: c5b02147-12a9-5c7b-80c2-d8e9e35d9a02

	/// EBITDA w PLN: marża brutto minus koszty operacyjne, wykonanie (ACT), tylko miesiące zamknięte do listopada 2026.
	measure 'EBITDA ACT' = [Marża brutto ACT] - [Koszty operacyjne ACT]
		formatString: #,0
		displayFolder: 1. Wykonanie (ACT)
		lineageTag: 1eb05cca-d017-5b81-b63c-24cc09e78e9b

	/// Marża EBITDA jako procent sprzedaży netto, wykonanie (ACT), tylko miesiące zamknięte do listopada 2026.
	measure 'EBITDA % ACT' = DIVIDE ( [EBITDA ACT], [Sprzedaż netto ACT] )
		formatString: 0.0%
		displayFolder: 1. Wykonanie (ACT)
		lineageTag: 973c3c3e-6b5b-5e73-b818-0b529fc1d51a

	/// Amortyzacja w PLN, wykonanie (ACT), tylko miesiące zamknięte do listopada 2026.
	measure 'Amortyzacja ACT' = CALCULATE ( [Kwota ACT], REMOVEFILTERS ( 'Konto' ), 'Konto'[Sekcja P&L] = "Amortyzacja" )
		formatString: #,0
		displayFolder: 1. Wykonanie (ACT)
		lineageTag: cc924f2f-76e8-56f6-ac87-d9da96787149

	/// EBIT w PLN: EBITDA minus amortyzacja, wykonanie (ACT), tylko miesiące zamknięte do listopada 2026.
	measure 'EBIT ACT' = [EBITDA ACT] - [Amortyzacja ACT]
		formatString: #,0
		displayFolder: 1. Wykonanie (ACT)
		lineageTag: 2be8cca8-057c-52b3-aa17-4a19cf5f5464

	/// Kwota w PLN dla scenariusza budżet (BUD) dla lat finansowych 2024/25, 2025/26 i 2026/27. Działa dla dowolnego konta lub grupy kont wybranych filtrem tabeli Konto, np. czynsze to konto 5120. Koszty są dodatnie.
	measure 'Kwota BUD' = CALCULATE ( SUM ( 'Rachunek wyników'[kwota_pln] ), REMOVEFILTERS ( 'Scenariusz' ), 'Scenariusz'[Kod scenariusza] = "BUD" )
		formatString: #,0
		displayFolder: 2. Budżet (BUD)
		lineageTag: 65687a6c-2036-5b23-ae2c-ae6c093e8581

	/// Przychody ze sprzedaży netto (konto 4010) w PLN, budżet (BUD) dla lat finansowych 2024/25, 2025/26 i 2026/27.
	measure 'Sprzedaż netto BUD' = CALCULATE ( [Kwota BUD], REMOVEFILTERS ( 'Konto' ), 'Konto'[Numer konta] = "4010" )
		formatString: #,0
		displayFolder: 2. Budżet (BUD)
		lineageTag: 7a973b2b-426c-5ddd-bf4d-4fdd78323376

	/// Koszt własny sprzedaży (konto 4510) w PLN, budżet (BUD) dla lat finansowych 2024/25, 2025/26 i 2026/27.
	measure 'Koszt własny BUD' = CALCULATE ( [Kwota BUD], REMOVEFILTERS ( 'Konto' ), 'Konto'[Numer konta] = "4510" )
