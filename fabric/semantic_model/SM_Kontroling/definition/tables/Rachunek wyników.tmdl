	/// Koszt logistyki e-commerce (konto 5220) według wykonania podzielony przez liczbę zamówień e-commerce, w PLN na zamówienie.
	measure 'Koszt logistyki e-commerce na zamówienie ACT' =
			DIVIDE (
			    CALCULATE ( [Kwota ACT], REMOVEFILTERS ( 'Konto' ), 'Konto'[Numer konta] = "5220" ),
			    CALCULATE ( [Liczba zamówień e-commerce], KEEPFILTERS ( 'Data'[Miesiąc zamknięty] = TRUE () ) )
			)
		formatString: #,0.00
		displayFolder: 6. Wskaźniki
		lineageTag: 0c06683d-70ff-537a-9f45-afb0b5d298f1

	/// Budżetowy koszt logistyki e-commerce (konto 5220) podzielony przez faktyczną liczbę zamówień, w PLN na zamówienie.
	measure 'Koszt logistyki e-commerce na zamówienie BUD' =
			DIVIDE (
			    CALCULATE ( [Kwota BUD (miesiące zamknięte)], REMOVEFILTERS ( 'Konto' ), 'Konto'[Numer konta] = "5220" ),
			    CALCULATE ( [Liczba zamówień e-commerce], KEEPFILTERS ( 'Data'[Miesiąc zamknięty] = TRUE () ) )
			)
		formatString: #,0.00
		displayFolder: 6. Wskaźniki
		lineageTag: b50b8790-cafe-5a77-9a75-507f06cdfa49

