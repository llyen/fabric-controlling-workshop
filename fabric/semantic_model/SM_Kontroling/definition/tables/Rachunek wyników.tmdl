		displayFolder: 2. Budżet (BUD)
		lineageTag: 7d5a8dd1-2732-5a2f-950c-3b4d3059c8dc

	/// Marża brutto w PLN (sprzedaż netto minus koszt własny), budżet (BUD) dla lat finansowych 2024/25, 2025/26 i 2026/27.
	measure 'Marża brutto BUD' = [Sprzedaż netto BUD] - [Koszt własny BUD]
