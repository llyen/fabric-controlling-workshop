		lineageTag: 8b79f502-479d-5ff7-b7d3-790d932eed0a

	/// Suma kosztów operacyjnych w PLN, budżet (BUD) dla lat finansowych 2024/25, 2025/26 i 2026/27.
	measure 'Koszty operacyjne BUD' = CALCULATE ( [Kwota BUD], REMOVEFILTERS ( 'Konto' ), 'Konto'[Sekcja P&L] = "Koszty operacyjne" )
