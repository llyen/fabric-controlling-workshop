		lineageTag: f103aa95-b561-51d0-83d4-aa3cd6cacdce

	/// Marża brutto jako procent sprzedaży netto, budżet (BUD) dla lat finansowych 2024/25, 2025/26 i 2026/27.
	measure 'Marża brutto % BUD' = DIVIDE ( [Marża brutto BUD], [Sprzedaż netto BUD] )
