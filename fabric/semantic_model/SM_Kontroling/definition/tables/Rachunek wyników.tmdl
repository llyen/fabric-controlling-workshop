		displayFolder: 2. Budżet (BUD)
		lineageTag: 2eb62ecf-5a58-57d6-b53f-0eda5945215f

	/// Amortyzacja w PLN, budżet (BUD) dla lat finansowych 2024/25, 2025/26 i 2026/27.
	measure 'Amortyzacja BUD' = CALCULATE ( [Kwota BUD], REMOVEFILTERS ( 'Konto' ), 'Konto'[Sekcja P&L] = "Amortyzacja" )
